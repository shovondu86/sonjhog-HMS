# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./hospital.db

# To use PostgreSQL instead, comment the line above and uncomment/edit below:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hospital_db

# Login users, created by `python -m app.seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional: the voice agent's key (scope `agent`: read everything except /audit-log,
# write ONLY patients and appointments). Leave blank to skip creating it.
AGENT_USERNAME=
AGENT_PASSWORD=

# Used only to seed the hospital profile the first time (edit it later with PUT /hospital)
HOSPITAL_NAME=Hospital

# "Today" and "past date" are judged by this calendar
TIMEZONE=Asia/Dhaka

# SMS webhook — fired in the background when a new appointment is created.
# {phone} and {message} are substituted (URL-encoded) into SMS_API_URL.
SMS_ENABLED=false
SMS_API_URL=https://your-sms-provider.com/send?api_key=YOUR_KEY&to={phone}&msg={message}
SMS_METHOD=GET
