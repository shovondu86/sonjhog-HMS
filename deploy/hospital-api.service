# /etc/systemd/system/hospital-api.service
# Runs the app with gunicorn + uvicorn workers, bound to 127.0.0.1:8000 (nginx sits in front).
#
# Setup:
#   sudo cp deploy/hospital-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hospital-api
#   sudo systemctl status hospital-api

[Unit]
Description=Hospital Management API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/hospital_api
EnvironmentFile=/opt/hospital_api/.env
ExecStart=/opt/hospital_api/venv/bin/gunicorn app.main:app \
    -k uvicorn.workers.UvicornWorker \
    -w 4 \
    -b 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
